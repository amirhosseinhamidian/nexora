# Nexora v0.1 non-secret runtime configuration. No secrets belong in this file.
NEXORA_ENVIRONMENT=development
NEXORA_DEPLOYMENT_PROFILE=local_development
NEXORA_LOG_LEVEL=INFO
# Optional in development; required in private production.
# NEXORA_LOG_FILE=/absolute/path/to/nexora.jsonl
NEXORA_DEFAULT_LOCALE=fa
NEXORA_DEFAULT_THEME=system
NEXORA_API_HOST=127.0.0.1
NEXORA_API_PORT=8000
