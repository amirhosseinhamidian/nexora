# Nexora v0.1 non-secret runtime configuration. No secrets belong in this file.
NEXORA_ENVIRONMENT=development
NEXORA_DEPLOYMENT_PROFILE=local_development
NEXORA_LOG_LEVEL=INFO
# Optional in development; required in private production.
# NEXORA_LOG_FILE=/absolute/path/to/nexora.jsonl
# Dedicated non-public artifact root; required by the private runtime.
# NEXORA_ARTIFACT_ROOT=/absolute/path/to/encrypted/nexora-artifacts
NEXORA_DEFAULT_LOCALE=fa
NEXORA_DEFAULT_THEME=system
NEXORA_API_HOST=127.0.0.1
NEXORA_API_PORT=8000

# Private single-host deployment (paths must be absolute; never commit values).
# SOURCE_COMMIT_SHA=0000000000000000000000000000000000000000
# NEXORA_PRIVATE_BIND_ADDRESS=100.64.0.10
# NEXORA_DATABASE_DSN_FILE=/absolute/path/to/secrets/database.dsn
# NEXORA_POSTGRES_PASSWORD_FILE=/absolute/path/to/secrets/postgresql-password
# NEXORA_CANONICAL_ORIGIN_FILE=/absolute/path/to/secrets/canonical-origin
# NEXORA_AUTH_PEPPER_FILE=/absolute/path/to/secrets/auth-pepper
# NEXORA_TRD_BOT_BASE_URL_FILE=/absolute/path/to/secrets/trd-bot-base-url
# NEXORA_TRD_BOT_TOKEN_FILE=/absolute/path/to/secrets/trd-bot-token
# NEXORA_TLS_CERT_FILE=/absolute/path/to/secrets/tls.crt
# NEXORA_TLS_KEY_FILE=/absolute/path/to/secrets/tls.key
# NEXORA_AGE_RECIPIENT_FILE=/absolute/path/to/secrets/age-recipient.txt
# NEXORA_BACKUP_ROOT=/absolute/path/to/encrypted/runtime-backups
# NEXORA_BACKUP_OFFSITE_ROOT=/absolute/path/to/mounted/offsite-backups
# NEXORA_RETENTION_EVIDENCE_ROOT=/absolute/path/to/encrypted/retention-evidence
