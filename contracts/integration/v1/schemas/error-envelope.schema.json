{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexora.local/contracts/integration/v1/schemas/error-envelope.schema.json",
  "title": "Nexora integration error envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "correlation_id", "occurred_at", "error"],
  "properties": {
    "schema_version": {
      "const": "nexora-integration-error-v1"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_REQUEST",
            "UNAUTHORIZED",
            "FORBIDDEN",
            "NOT_FOUND",
            "IDEMPOTENCY_CONFLICT",
            "CURSOR_EXPIRED",
            "INCOMPATIBLE_CONTRACT",
            "UNSUPPORTED_SCHEMA",
            "CHECKSUM_MISMATCH",
            "SOURCE_UNAVAILABLE"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      }
    }
  }
}
