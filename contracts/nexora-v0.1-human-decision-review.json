{
  "schema_version": "nexora-human-decision-review-contract-v1",
  "decision_id": "NEX-P3-07",
  "status": "candidate",
  "title": "Human accept, reject and defer workflow",
  "prerequisites": {
    "p3_06_accepted_commit_sha": "bf8facf3124822a5d22a57d346a4ed0538a69d7d",
    "provider_release": "0.3.1",
    "decision_review_domain_contract": "nexora-decision-review-journal-domain-v1"
  },
  "review_actions": [
    "accept",
    "reject",
    "defer"
  ],
  "persistence": {
    "owner_scoped": true,
    "append_only_reviews": true,
    "correction_by_superseding_review": true,
    "optimistic_concurrency": true,
    "idempotency_key_required": true,
    "exact_payload_replay_is_idempotent": true,
    "different_payload_replay_is_conflict": true,
    "source_evidence_generation_required": true,
    "source_evidence_checksum_required": true
  },
  "reason_policy": {
    "owner_namespace_required": true,
    "provider_namespace_remains_separate": true,
    "other_with_note_requires_note": true,
    "defer_revisit_at_optional": true
  },
  "provider_feedback": {
