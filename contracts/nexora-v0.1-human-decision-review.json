    "delivery_occurs_after_local_commit": true,
    "failed_delivery_remains_pending": true,
    "same_idempotency_key_retries_pending_delivery": true,
    "exact_decision_evaluation_reference_required": true,
    "secret_or_raw_provider_error_persisted": false
  },
  "api": {
    "authenticated": true,
    "owner_scoped": true,
    "get_context_path": "/v1/decisions/{decision_id}/reviews",
    "create_review_path": "/v1/decisions/{decision_id}/reviews",
    "active_generation_only": true,
    "stale_evidence_action": "conflict",
    "version_conflict_action": "conflict"
  },
  "security_boundary": {
    "review_authorizes_execution": false,
    "review_creates_order_intent": false,
    "review_posts_transaction": false,
    "review_submits_order": false,
    "review_moves_funds": false,
    "exchange_credentials_added": false,
    "live_trading_added": false
  },
  "web": {
    "actions_visible": true,
    "owner_reason_visible": true,
    "review_history_visible": true,
    "delivery_state_visible": true,
    "paper_shadow_mode_explicit": true,
    "safety_boundary_visible": true
  },
  "transition": {
    "next_allowed_stage_after_ci_acceptance": "NEX-P3-08",
    "separate_freeze_task_required": false,
    "nex_p3_03_gate_opened": false,
    "real_local_provider_smoke_required_later": true
  }
