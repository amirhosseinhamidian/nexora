    "external_flow_kinds": [
      "opening_balance",
      "deposit",
      "withdrawal"
    ],
    "performance_point_minimum": 2,
    "performance_point_maximum": 32,
    "performance_range_maximum_days": 366,
    "unavailable_subperiod_breaks_cumulative_chain": true
  },
  "valuation_resolution": {
    "precedence": [
      "base_asset_identity",
      "direct_price_observation",
      "direct_fx_rate_for_fiat",
      "price_observation_plus_one_direct_fx_hop",
      "portfolio_manual_valuation",
      "missing"
    ],
    "future_evidence_excluded": true,
    "deterministic_latest_at_or_before": true,
    "stale_evidence_remains_selected_and_visible": true,
    "manual_never_overwrites_observation": true,
    "implicit_fx_inversion": false,
    "multi_hop_fx_graph": false,
    "interpolation": false,
    "silent_forward_fill": false,
    "evidence_ids_and_source_references_returned": true
  },
  "persistence": {
