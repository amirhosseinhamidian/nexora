    "append_only": true,
    "decision_reference_required": true,
    "review_reference_optional": true,
    "portfolio_reference_optional": true,
    "simulated_position_reference_optional": true,
    "entry_kinds": [
      "owner_note",
      "review_rationale",
      "observed_outcome",
      "expectation_comparison",
      "lesson",
      "correction"
    ],
    "uncertainty_levels": [
      "low",
      "medium",
      "high",
      "unknown"
    ],
    "occurred_at_required": true,
    "recorded_at_required": true,
    "idempotency_key_required": true,
    "exact_payload_replay_is_idempotent": true,
    "different_payload_replay_is_conflict": true,
    "mutation_after_recording": false,
    "deletion": false,
    "correction_requires_superseded_entry": true,
    "single_direct_correction_per_entry": true
  },
  "lineage": {
