{
  "schema_version": "nexora-outcome-journal-contract-v1",
  "decision_id": "NEX-P3-10",
  "status": "candidate",
  "title": "Decision and Outcome Journal",
  "prerequisites": {
    "p3_09_accepted_commit_sha": "7a06093b5ce81a60353797e61d8aadcbd40b40e0",
    "decision_review_domain_contract": "nexora-decision-review-journal-domain-v1"
  },
  "journal": {
