  "phase_four_roadmap": [
    {
      "stage_id": "NEX-P4-00",
      "title": "Roadmap Reconciliation and Freeze",
      "outcome": "Freeze the authoritative capability, route, API, content, security and acceptance plan before feature implementation.",
      "status": "candidate",
      "depends_on": ["NEX-P3-13-FREEZE"]
    },
    {
      "stage_id": "NEX-P4-01",
      "title": "UI Foundation and Micro Components",
      "outcome": "Deliver reusable accessible primitives, feedback, overlays and data-presentation components.",
      "status": "planned",
      "depends_on": ["NEX-P4-00-FREEZE"]
    },
    {
      "stage_id": "NEX-P4-02",
      "title": "Platform Shell Navigation and Routes",
      "outcome": "Replace anchor navigation with routed pages, directional collapsible navigation and a responsive full-width page frame.",
      "status": "planned",
      "depends_on": ["NEX-P4-01-FREEZE"]
    },
    {
      "stage_id": "NEX-P4-03",
      "title": "First Run Onboarding",
      "outcome": "Allow a new owner to create the base asset, first Portfolio and optional Account without direct API use.",
      "status": "planned",
      "depends_on": ["NEX-P4-02-FREEZE"]
    },
    {
      "stage_id": "NEX-P4-04",
      "title": "Asset Portfolio and Account Management",
      "outcome": "Expose the existing registry lifecycle through clear routed management experiences.",
      "status": "planned",
      "depends_on": ["NEX-P4-03-FREEZE"]
    },
    {
      "stage_id": "NEX-P4-05",
      "title": "Portfolio Overview and Analytics",
      "outcome": "Deliver a readable Portfolio overview with valuation health, allocation, performance, comparisons and explicit uncertainty.",
      "status": "planned",
      "depends_on": ["NEX-P4-04-FREEZE"]
    },
    {
      "stage_id": "NEX-P4-06",
      "title": "Accounting and Reconciliation Experience",
      "outcome": "Deliver routed transaction, holdings, lots, import and reconciliation workflows without weakening immutable accounting rules.",
      "status": "planned",
      "depends_on": ["NEX-P4-05-FREEZE"]
    },
    {
      "stage_id": "NEX-P4-07",
      "title": "Decision Intelligence Pages",
      "outcome": "Move Decision, Candidate, Risk, Impact and Review capabilities into a complete routed workflow.",
      "status": "planned",
      "depends_on": ["NEX-P4-06-FREEZE"]
    },
    {
      "stage_id": "NEX-P4-08",
      "title": "Alerts Watchlists and Outcome Journal",
      "outcome": "Deliver the routed monitoring and outcome lifecycle from Alert or Decision evidence to Journal history.",
      "status": "planned",
      "depends_on": ["NEX-P4-07-FREEZE"]
    },
    {
      "stage_id": "NEX-P4-09",
      "title": "Exports and Settings",
      "outcome": "Deliver complete export creation, history, verification, download and bounded owner preferences.",
      "status": "planned",
      "depends_on": ["NEX-P4-08-FREEZE"]
    },
    {
      "stage_id": "NEX-P4-10",
      "title": "Content Localization Accessibility and Responsive Hardening",
      "outcome": "Audit and harden plain language, Persian terminology, bilingual direction, themes, accessibility and viewport behavior.",
      "status": "planned",
      "depends_on": ["NEX-P4-09-FREEZE"]
    },
    {
      "stage_id": "NEX-P4-11",
      "title": "Product End to End Acceptance Candidate",
      "outcome": "Bind complete owner journeys and the visual acceptance matrix to one candidate SHA.",
      "status": "planned",
      "depends_on": ["NEX-P4-10-FREEZE"]
    },
    {
      "stage_id": "NEX-P4-12",
      "title": "Phase 4 Final Acceptance and Freeze",
      "outcome": "Freeze the accepted local v0.1 product experience without claiming production readiness.",
      "status": "planned",
      "depends_on": ["NEX-P4-11-FREEZE"]
    }
  ],
  "stage_execution_policy": {
