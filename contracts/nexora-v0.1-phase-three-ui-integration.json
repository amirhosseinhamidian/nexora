    "minimum_interactive_target_css_pixels": 44,
    "live_status_announcements": true,
    "status_not_conveyed_by_color_only": true,
    "reduced_motion_respected": true
  },
  "browser_acceptance": {
    "fixture_backed": true,
    "chromium_required": true,
    "real_provider_dependency": false,
    "persian_rtl_required": true,
    "english_ltr_required": true,
    "mobile_viewport_required": true,
    "keyboard_workflow_required": true,
    "loading_empty_error_degraded_required": true
  },
  "api_boundary": {
    "same_origin_api_only": true,
