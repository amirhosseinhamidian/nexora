  "integration": {
    "single_owner_workspace": true,
    "selected_decision_context_shared": true,
    "selected_decision_opens_outcome_journal": true,
    "source_lineage_visible": true,
    "uncertainty_visible": true,
    "review_and_alert_history_visible": true,
    "safety_boundaries_visible": true,
    "new_backend_route_required": false,
    "new_database_migration_required": false
  },
  "localization_and_layout": {
