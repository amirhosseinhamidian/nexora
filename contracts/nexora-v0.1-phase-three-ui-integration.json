{
  "schema_version": "nexora-phase-three-ui-integration-v1",
  "decision_id": "NEX-P3-12",
  "decision_date": "2026-11-18",
  "status": "candidate",
  "title": "Phase 3 UI Integration, Accessibility and End-to-end",
  "prerequisites": {
    "p3_11_accepted_commit_sha": "306f2d1141bec65386c961e9fe36f9ab193fee3c",
    "phase_three_export_contract": "nexora-phase-three-export-coverage-v1",
