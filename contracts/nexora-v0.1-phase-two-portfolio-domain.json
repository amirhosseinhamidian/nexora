  "phase_two_roadmap": [
    {
      "stage_id": "NEX-P2-01",
      "title": "Portfolio Domain and Phase Two Roadmap",
      "outcome": "Freeze the domain language, accounting invariants, boundaries and delivery order.",
      "status": "candidate"
    },
    {
      "stage_id": "NEX-P2-02",
      "title": "Portfolio, Asset and Account Registry",
      "outcome": "Persist owner-scoped portfolios, assets, identifiers and accounts.",
      "status": "planned"
    },
    {
      "stage_id": "NEX-P2-03",
      "title": "Immutable Transaction Journal",
      "outcome": "Persist idempotent transactions and immutable balanced legs with correction lineage.",
      "status": "planned"
    },
    {
      "stage_id": "NEX-P2-04",
      "title": "Import and Reconciliation Runtime",
      "outcome": "Add dry-run imports, deduplication, quarantine and owner-reviewed reconciliation.",
      "status": "planned"
    },
    {
      "stage_id": "NEX-P2-05",
      "title": "Holdings, Lots and Cost Basis",
      "outcome": "Build deterministic rebuildable holdings and lot projections.",
      "status": "planned"
    },
    {
      "stage_id": "NEX-P2-06",
      "title": "Price, FX and Manual Valuation",
      "outcome": "Store immutable price evidence and explicit manual valuations with uncertainty.",
      "status": "planned"
    },
    {
      "stage_id": "NEX-P2-07",
      "title": "NAV, P&L and Performance",
      "outcome": "Derive point-in-time NAV, realized and unrealized P&L and bounded performance series.",
      "status": "planned"
    },
    {
      "stage_id": "NEX-P2-08",
      "title": "TRD Bot Paper/Shadow Projection",
      "outcome": "Project compatible Paper/Shadow evidence without direct database access or live execution.",
      "status": "planned"
    },
    {
      "stage_id": "NEX-P2-09",
      "title": "Portfolio API and Export",
      "outcome": "Expose owner-scoped read APIs and deterministic private/AI-safe exports.",
      "status": "planned"
    },
    {
      "stage_id": "NEX-P2-10",
      "title": "Portfolio Dashboard and Accounts UI",
      "outcome": "Deliver bilingual responsive overview, valuation status and account registry screens.",
      "status": "planned"
    },
    {
      "stage_id": "NEX-P2-11",
      "title": "Transactions, Holdings and Reconciliation UI",
      "outcome": "Deliver journal, holdings, lots, import review and reconciliation workflows.",
      "status": "planned"
    },
    {
      "stage_id": "NEX-P2-12",
      "title": "Acceptance, Hardening and Freeze",
      "outcome": "Bind deterministic accounting, migrations, export, browser and private-runtime evidence to one SHA.",
      "status": "planned"
    }
  ],
