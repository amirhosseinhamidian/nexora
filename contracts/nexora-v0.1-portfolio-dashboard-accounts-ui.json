    "exact_string_rounding_for_display": true,
    "nav_state_is_visible": true,
    "stale_state_is_visible": true,
    "missing_state_is_visible": true,
    "allocation_uses_priced_positions_only": true,
    "unpriced_positions_cannot_be_implied_as_zero": true,
    "as_of_timestamp_is_visible": true,
    "synthetic_or_demo_financial_values": false
  },
  "account_registry_boundary": {
    "selected_portfolio_filter": true,
    "account_name": true,
    "account_kind": true,
    "institution_name": true,
    "lifecycle_status": true,
    "registry_key": true,
    "external_account_reference_rendered": false,
    "exchange_credentials_rendered": false,
    "account_mutation_ui": false
  },
  "state_model": {
    "states": [
      "loading",
      "ready",
      "empty",
      "error",
      "stale",
      "missing"
    ],
    "registry_failure_preserves_no_mutation": true,
    "analytics_failure_keeps_account_registry_visible": true,
    "portfolio_selection_reloads_owner_scoped_details": true,
    "session_expiry_uses_existing_shell_recovery": true
  },
  "accessibility": {
    "semantic_headings": true,
    "labelled_portfolio_selector": true,
    "keyboard_navigation": true,
