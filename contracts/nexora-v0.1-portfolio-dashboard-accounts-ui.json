    "reduced_motion_respected": true,
    "mobile_horizontal_page_overflow": false
  },
  "security_boundary": {
    "public_internet_deployment": false,
    "multi_user": false,
    "exchange_credentials": false,
    "wallet_private_keys_or_signing": false,
    "fund_transfer": false,
    "live_order_capability": false,
    "autonomous_ai_execution": false,
    "ml_training_or_inference": false,
    "financial_advice": false,
    "tax_advice": false,
    "direct_trd_bot_database_access": false
  },
  "transition": {
    "ready_for_candidate": true,
    "next_allowed_stage": "NEX-P2-10-FREEZE",
    "post_freeze_stage": "NEX-P2-11",
    "p2_11_before_transactions_holdings_reconciliation_ui": true
  }
