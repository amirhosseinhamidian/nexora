{
  "$defs": {
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{2,79}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "error": {
      "$ref": "#/$defs/ErrorDetail"
    },
    "schema_version": {
      "const": "nexora-error-envelope-v1",
      "default": "nexora-error-envelope-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "correlation_id",
    "error"
  ],
  "title": "ErrorEnvelope",
  "type": "object"
}
